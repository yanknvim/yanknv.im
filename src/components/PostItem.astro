---
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;

const formatDate = (date: Date) =>
  date.toLocaleDateString("ja-JP", {
    year: "numeric",
    month: "long",
    day: "numeric",
    timeZone: "UTC",
  });
---

<li class="py-4">
  <a href={`/posts/${post.id}/`} class="group block">
    <time
      datetime={post.data.pubDate.toISOString()}
      class="font-mono text-sm text-gray-500 dark:text-gray-400"
    >
      {formatDate(post.data.pubDate)}
    </time>
    <h2 class="text-xl font-bold group-hover:underline">
      {post.data.title}
    </h2>
    <p class="text-gray-600 dark:text-gray-400">{post.data.description}</p>
  </a>
</li>
