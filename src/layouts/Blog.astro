---
import Default from "./Default.astro";
import Prose from "../components/Prose.astro";

const { title, description, pubDate } = Astro.props;

const isoDate = pubDate.toISOString();
const displayDate = pubDate.toLocaleDateString("ja-JP", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC",
});
---

<Default title={title}>
  <main class="mx-auto max-w-2xl px-4 py-10">
    <article>
      <header class="mb-10 border-b border-gray-200 pb-6 dark:border-gray-800">
        <h1 class="text-3xl font-bold leading-tight">{title}</h1>
        <p class="mt-3 text-gray-600 dark:text-gray-400">{description}</p>
        <p class="mt-4 font-mono text-sm text-gray-500 dark:text-gray-400">
          <time datetime={isoDate}>{displayDate}</time>
        </p>
      </header>

      <Prose jaIndent>
        <slot />
      </Prose>

      <footer class="mt-12 pt-6">
        <a href="/posts" class="font-mono text-sm text-gray-500 hover:text-gray-900 dark:text-gray-400 dark:hover:text-gray-100">
          ← 記事一覧へ
        </a>
      </footer>
    </article>
  </main>
</Default>
